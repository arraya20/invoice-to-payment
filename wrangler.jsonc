{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invoice-to-payment-agent",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-14",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
